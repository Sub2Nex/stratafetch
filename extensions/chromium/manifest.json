{
  "manifest_version": 3,
  "name": "StrataFetch",
  "version": "0.1.1",
  "description": "Send a link to your local StrataFetch download manager.",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
