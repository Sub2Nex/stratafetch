{
  "manifest_version": 3,
  "minimum_chrome_version": "106",
  "name": "StrataFetch",
  "version": "0.2.4",
  "description": "Send browser downloads to StrataFetch. Choose the desktop app or keep downloading in your browser.",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "activeTab",
    "downloads",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
