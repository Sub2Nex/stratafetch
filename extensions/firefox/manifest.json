{
  "manifest_version": 3,
  "name": "StrataFetch",
  "version": "0.2.7",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "activeTab",
    "downloads",
    "storage",
    "webRequest"
  ],
  "background": {
    "scripts": [
      "locale.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "stratafetch@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteActivity",
          "websiteContent"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "default_locale": "en",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
