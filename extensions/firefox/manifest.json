{
  "manifest_version": 3,
  "name": "StrataFetch",
  "version": "0.2.3",
  "description": "Send browser downloads to StrataFetch. Choose the desktop app or keep downloading in your browser.",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "activeTab",
    "downloads",
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "stratafetch@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteActivity",
          "websiteContent"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
